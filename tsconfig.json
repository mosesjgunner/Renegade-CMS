{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./src/payload.config.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-rc104a/types/**/*.ts",
    ".next-rc104a/dev/types/**/*.ts",
    ".next-rc104b/types/**/*.ts",
    ".next-rc104b/dev/types/**/*.ts",
    ".next-rc104c/types/**/*.ts",
    ".next-rc104c/dev/types/**/*.ts",
    ".next-rc104d/types/**/*.ts",
    ".next-rc104d/dev/types/**/*.ts",
    ".next-rc104e/types/**/*.ts",
    ".next-rc104e/dev/types/**/*.ts",
    ".next-rc105b/types/**/*.ts",
    ".next-rc105b/dev/types/**/*.ts",
    ".next-rc105c/types/**/*.ts",
    ".next-rc105c/dev/types/**/*.ts",
    ".next-rc105a/types/**/*.ts",
    ".next-rc105a/dev/types/**/*.ts",
    ".next-rc106a/types/**/*.ts",
    ".next-rc106a/dev/types/**/*.ts",
    ".next-rc107a/types/**/*.ts",
    ".next-rc107a/dev/types/**/*.ts",
    ".next-rc107c/types/**/*.ts",
    ".next-rc107c/dev/types/**/*.ts",
    ".next-rc107b/types/**/*.ts",
    ".next-rc107b/dev/types/**/*.ts",
    ".next-rc108a/types/**/*.ts",
    ".next-rc108a/dev/types/**/*.ts",
    ".next-rc108b/types/**/*.ts",
    ".next-rc108b/dev/types/**/*.ts",
    ".next-rc103b-current-20261020/types/**/*.ts",
    ".next-rc103b-current-20261020/dev/types/**/*.ts",
    ".next-rc108c/types/**/*.ts",
    ".next-rc108c/dev/types/**/*.ts",
    ".next-rc103d-20261020/types/**/*.ts",
    ".next-rc103d-20261020/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch",
    ".payload-upstream",
    "docs",
    ".next"
  ]
}
