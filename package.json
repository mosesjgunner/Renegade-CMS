{
  "name": "renegade-cms",
  "version": "0.1.0",
  "private": true,
  "description": "A free, self-hosted, portable publishing and personal-brand platform.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "npm run payload -- migrate",
    "db:status": "npm run payload -- migrate:status",
    "db:seed": "npm run payload -- seed",
    "installation:recover": "npm run payload -- recover-installation",
    "generate:types": "npm run payload -- generate:types",
    "generate:importmap": "npm run payload -- generate:importmap",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:migrations:fresh": "tsx src/scripts/verify-fresh-migration.ts",
    "test:migrations:upgrade": "tsx src/scripts/verify-upgrade-migration.ts",
    "test:smoke": "tsx tests/smoke/stack.smoke.ts",
    "verify:release:checks": "tsx src/scripts/verify-release.ts",
    "verify:release": "node scripts/verify-clean-clone.mjs",
    "verify": "npm run verify:release",
    "jobs:worker": "tsx src/scripts/run-jobs-worker.ts",
    "worker:health": "node docker/worker-healthcheck.mjs",
    "backup:operational": "tsx src/scripts/operational-backup.ts",
    "restore:operational": "tsx src/scripts/operational-restore.ts",
    "status:operational": "tsx src/scripts/operational-status.ts",
    "maintenance:operational": "tsx src/scripts/operational-maintenance.ts",
    "upgrade:operational": "tsx src/scripts/operational-upgrade.ts",
    "rollback:operational": "tsx src/scripts/operational-rollback.ts",
    "portability": "tsx src/scripts/portability.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@puckeditor/core": "^0.23.0",
    "@simplewebauthn/server": "^13.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.1",
    "cross-env": "10.1.0",
    "graphql": "16.11.0",
    "jose": "5.10.0",
    "next": "16.3.0",
    "nodemailer": "9.0.6",
    "payload": "3.88.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "^7.8.5",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/nodemailer": "7.0.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
