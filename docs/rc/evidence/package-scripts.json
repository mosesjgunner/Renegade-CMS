{
  "build": "cross-env NODE_OPTIONS=--no-deprecation next build && node -e \"const fs = require('fs'); fs.cpSync('theme-packages', '.next/standalone/theme-packages', { recursive: true }); fs.cpSync('.next/static', '.next/standalone/.next/static', { recursive: true }); if (fs.existsSync('public')) fs.cpSync('public', '.next/standalone/public', { recursive: true });\"",
  "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
  "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
  "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
  "db:migrate": "npm run payload -- migrate",
  "db:status": "npm run payload -- migrate:status",
  "db:seed": "npm run payload -- seed",
  "installation:recover": "npm run payload -- recover-installation",
  "generate:types": "cross-env RENEGADE_MODULES=all RENEGADE_ALLOW_UNSAFE_COLLECTION_COUNT=true npm run payload -- generate:types",
  "generate:importmap": "cross-env RENEGADE_MODULES=all RENEGADE_ALLOW_UNSAFE_COLLECTION_COUNT=true npm run payload -- generate:importmap",
  "semantic-url:backfill": "tsx src/scripts/semantic-url-backfill.ts",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "lint": "eslint . --max-warnings=0",
  "typecheck": "tsc --noEmit",
  "test": "vitest run tests/unit",
  "test:integration": "cross-env ALLOW_FIXTURE_SEED=true RENEGADE_MODULES=all RENEGADE_ALLOW_UNSAFE_COLLECTION_COUNT=true vitest run tests/integration --no-file-parallelism",
  "test:browser": "cross-env RENEGADE_MODULES=all RENEGADE_ALLOW_UNSAFE_COLLECTION_COUNT=true playwright test",
  "test:migrations:fresh": "tsx src/scripts/verify-fresh-migration.ts",
  "test:migrations:upgrade": "tsx src/scripts/verify-upgrade-migration.ts",
  "test:migrations:commerce": "tsx src/scripts/verify-commerce-migrations.ts",
  "test:smoke": "tsx tests/smoke/stack.smoke.ts",
  "verify:release:checks": "tsx src/scripts/verify-release.ts",
  "verify:presentation-bundles": "node scripts/verify-presentation-bundles.mjs",
  "verify:release": "node scripts/verify-clean-clone.mjs",
  "verify": "npm run verify:release",
  "jobs:worker": "tsx src/scripts/run-jobs-worker.ts",
  "worker:health": "node docker/worker-healthcheck.mjs",
  "backup:operational": "tsx src/scripts/operational-backup.ts --",
  "restore:operational": "tsx src/scripts/operational-restore.ts --",
  "restore:prepare-env": "tsx src/scripts/prepare-restore-environment.ts --",
  "restore:rehearsal": "tsx src/scripts/operational-restore-rehearsal.ts --",
  "status:operational": "tsx src/scripts/operational-status.ts --",
  "maintenance:operational": "tsx src/scripts/operational-maintenance.ts --",
  "upgrade:operational": "tsx src/scripts/operational-upgrade.ts --",
  "rollback:operational": "tsx src/scripts/operational-rollback.ts --",
  "portability": "tsx --env-file=.env src/scripts/portability.ts"
}
