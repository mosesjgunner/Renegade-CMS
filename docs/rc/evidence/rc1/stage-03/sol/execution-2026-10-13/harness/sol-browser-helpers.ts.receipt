import { expect, type Browser } from '@playwright/test'
import { readFileSync, writeFileSync } from 'node:fs'
export async function passkeyLogin(browser: Browser, email: string, credentialFile: string) {
  const context = await browser.newContext({ ignoreHTTPSErrors: true })
  const page = await context.newPage()
  const cdp = await context.newCDPSession(page)
  await cdp.send('WebAuthn.enable')
  const { authenticatorId } = await cdp.send('WebAuthn.addVirtualAuthenticator', { options: {
    protocol: 'ctap2', transport: 'internal', hasResidentKey: true, hasUserVerification: true,
    isUserVerified: true, automaticPresenceSimulation: true,
  } })
  for (const credential of JSON.parse(readFileSync(credentialFile, 'utf8')))
    await cdp.send('WebAuthn.addCredential', { authenticatorId, credential })
  await page.goto('/login')
  await page.getByLabel('Owner / Staff Email').fill(email)
  // Preserve the actual device counter after every assertion, including a rejected
  // stale snapshot. A second signed challenge advances the simulated device itself.
  for (let attempt = 0; attempt < 3; attempt++) {
    const response = page.waitForResponse(r => r.url().endsWith('/api/auth/passkey/complete'))
    await page.getByRole('button', { name: /Authenticate with Passkey/ }).click()
    const verified = await response
    const { credentials } = await cdp.send('WebAuthn.getCredentials', { authenticatorId })
    writeFileSync(credentialFile, JSON.stringify(credentials))
    if (verified.ok()) break
    await expect(page.getByRole('alert').filter({ hasText: 'could not be verified' })).toBeVisible()
  }
  await expect(page).toHaveURL(/\/admin/, { timeout: 60_000 })
  expect((await context.cookies()).some(c => c.name === 'renegade-passkey')).toBe(true)
  if (email === 'editor@renegadeparty.test') await context.storageState({ path: 'scratch/rc02-owner.json' })
  return context
}
