# Runtime mode. Production activates stricter URL, secret, credential, and storage checks.
NODE_ENV=development

# PostgreSQL connection used by Payload. The development value matches compose.yaml.
DATABASE_URL=postgresql://renegade:renegade_dev_only@localhost:5432/renegade

# Payload signing secret. Use 32+ random characters in development and 48+ in production.
# Known example/placeholder values are rejected.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Canonical origin used for generated URLs, CORS, CSRF, and secure-cookie policy.
# Production requires a non-loopback HTTPS origin with no path or trailing slash.
APP_URL=http://localhost:3000

# direct: do not treat forwarded address headers as trusted application evidence.
# trusted: an explicitly configured reverse proxy overwrites forwarded headers.
# Production requires an explicit choice. See docs/operations/reverse-proxy.md.
PROXY_MODE=direct
TRUSTED_PROXY_HOPS=1

# M02 base storage is a local directory. Production requires an absolute path on a persistent volume.
STORAGE_DRIVER=local
MEDIA_DIR=./media

# Email delivery: disabled, development (in-memory capture), or smtp. SMTP authentication is optional;
# SMTP_USERNAME and SMTP_PASSWORD must be configured together. TLS certificate validation is always enabled.
EMAIL_MODE=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SEND_TIMEOUT_MS=30000

# Exposes the authenticated foundation smoke endpoint. Production rejects this setting when true.
ENABLE_TEST_ROUTES=false

# Required only when ENABLE_TEST_ROUTES=true. Send as x-renegade-smoke-token.
SMOKE_TEST_TOKEN=

# Structured log threshold: debug, info, warn, or error.
LOG_LEVEL=info

# Optional build metadata displayed by authenticated diagnostics in M02.
APP_VERSION=0.1.0-dev
BUILD_SHA=

# Optional intended setup owner. This identifies the owner during setup but is never authentication.
OWNER_EMAIL=
