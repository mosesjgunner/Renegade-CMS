		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Harbor Light is a two-person restoration studio on Pier 4.</p>
<!-- /wp:paragraph -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><p>Measure twice, varnish once.</p><cite>Tom Dock</cite></blockquote>
<!-- /wp:quote -->

