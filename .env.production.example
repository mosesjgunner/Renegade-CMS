# Copy to .env.production. These values intentionally fail production validation
# until replaced; do not use .env.example for a public production deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
PAYLOAD_SECRET=replace-with-at-least-48-random-characters
APP_URL=https://cms.example.com
PROXY_MODE=trusted
TRUSTED_PROXY_HOPS=1
RENEGADE_WEB_BIND=127.0.0.1:3000
RENEGADE_IMAGE_TAG=local

# Lean is suitable for a 1 GB-class VPS; Standard is the normal 2 GB+ profile.
# Profiles do not change the database schema.
DEPLOYMENT_PROFILE=Standard
APP_VERSION=0.1.0
LOG_LEVEL=info
EMAIL_MODE=disabled